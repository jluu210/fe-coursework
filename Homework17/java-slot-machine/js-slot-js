import { createInterface } from "node:readline/promises";
import { stdin as input, stdout as output } from "node:process";

const user_input = createInterface({ input, output });
const symbols = ["🍒", "🌶️", "⭐", "💎", "💲"];
const payOut = {
  "🍒": 1,
  "🌶️": 2,
  "⭐": 5,
  "💎": 25,
};

const symbolWeight = {
  "🍒": 40,
  "🌶️": 30,
  "⭐": 20,
  "💎": 10,
  "💲": 5,
};

const startBalance = 100;
function startUpDisplay() {
  console.clear();
  console.log(`
Welcome to the JS Slot Machine!

Match 3 symbols to win.

    Pay Outs:
        3 🍒 =   1× bet
        3 🌶️  =   2× bet
        3 ⭐ =   5× bet
        3 💎 =  25× bet
        3 💲 = 100x bet

$'s are WILD

Balance: ${startBalance}
`);
}

function wait(time) {
  return new Promise((resolve) => setTimeout(resolve, time));
}

async function flashOnWin(reels, bet, balance, winnings) {
  let visible = true; //when true the reel is visable

  user_input.setPrompt("Enter a bet [q]uit: ");

  //wait for user to input new bet
  const betPromise = new Promise((resolve) => {
    user_input.once("line", resolve);
  });

  function flash() {
    console.clear();
    console.log("JS Slot Machine\n");

    console.log(visible ? `[ ${reels.join(" | ")} ]` : `✨WIN $${winnings}✨`);

    console.log(`\nBet: $${bet}\n`);
    console.log(`Balance: $${balance}\n`);

    user_input.prompt(true);
    visible = !visible;
  }
  flash();
  const animation = setInterval(flash, 300);

  const betInput = await betPromise;
  clearInterval(animation);
  return betInput.trim().toLowerCase();
}

async function spinReels(bet, balance) {
  for (let i = 0; i < 3; i++) {
    console.clear();
    console.log("JS Slot Machine \n");

    const display = Array.from(
      { length: 3 },
      () => symbols[Math.floor(Math.random() * symbols.length)]
    );

    console.log(`[ ${display.join(" | ")} ]`);
    console.log(`\nBet: $${bet}\n`);
    console.log(`Balance: $${balance}\n`);
    await wait(400);
  }
  //TODO: multiply by weights to determine selection.
  // Choose the final result for all three reels.
  return Array.from(
    { length: 3 },
    () => symbols[Math.floor(Math.random() * symbols.length)]
  );
}

function determineWinner(reels, bet) {
  //wins with all dollar signs are a super payout
  const dollarCount = reels.filter((symbol) => symbol === "💲").length;
  if (dollarCount === 3) {
    return bet * 100;
  }
  //dollar signs are wild
  const matchingSymbols = reels.filter((symbol) => symbol !== "💲");
  if (
    matchingSymbols.length > 0 &&
    matchingSymbols.every((symbol) => symbol === matchingSymbols[0])
  ) {
    return bet * payOut[matchingSymbols[0]];
  }

  const allMatch = reels.every((symbol) => symbol === reels[0]);

  if (allMatch) {
    return bet * payOut[reels[0]];
  }

  return 0;
}

async function gameLoop() {
  let balance = startBalance;
  let nextBetInput = "";

  while (balance > 0) {
    //wait for user bet
    const betInput =
      nextBetInput ||
      (await user_input.question("Enter a bet [q]uit: ")).toLowerCase();
    nextBetInput = "";
    if (betInput === "q" || betInput === "quit") {
      break;
    }
    const bet = Number(betInput);
    if (!Number.isInteger(bet) || bet <= 0 || bet > balance) {
      console.log("Enter a valid bet within your balance.");
      continue;
    }
    balance -= bet;
    const reels = await spinReels(bet, balance);
    console.clear();
    console.log("JS Slot Machine");
    console.log(`\n[ ${reels.join(" | ")} ]\n`);
    const winnings = determineWinner(reels, bet);
    if (winnings > 0) {
      balance += winnings;
      nextBetInput = await flashOnWin(reels, bet, balance, winnings);
    } else {
      console.log(`Bet: $${bet}\n`);
      console.log(`Balance: $${balance}\n`);
    }
  }
  user_input.close();
}

startUpDisplay();
gameLoop();
